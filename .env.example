# Production site URL (no trailing slash). Used for canonical URLs, sitemap,
# robots.txt and structured data.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Google Search Console HTML tag verification value.
# Get this from Search Console > Settings > Ownership verification > HTML tag.
# Paste only the "content" value, not the whole meta tag.
NEXT_PUBLIC_GSC_VERIFICATION=

# Google Analytics 4 Measurement ID (starts with G-).
# Leave empty to disable Analytics entirely.
NEXT_PUBLIC_GA_ID=
